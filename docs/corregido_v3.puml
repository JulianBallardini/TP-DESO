@startuml Clases
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
scale max 2800 width
top to bottom direction

title Diagrama de Clases Integral - Sistema de Selección y Evaluaciones

' --- ENUMS Y CONFIGURACIONES ---
enum TipoPregunta {
    OPCION_MULTIPLE
    VERDADERO_FALSO
    ESCALA
}

enum EstadoCuestionario {
    PENDIENTE
    EN_CURSO
    COMPLETADO
    INCOMPLETO
    SIN_CONTESTAR
}

enum EstadoEvaluacion {
    ABIERTA
    CERRADA
}

' ==========================================
' FRONTERA (PANTALLAS)
' ==========================================

package "Pantallas" {
  class PantallaExportarResultados {
      + solicitarOpcionesBúsqueda()
      + seleccionarUbicacionGuardado()
      + mostrarMensajeExito()
  }
  
  class PantallaReporteComparativo {
      + solicitarCandidatoYPuesto()
      + mostrarReporteComparativo()
      + solicitarImpresion()
  }
  
  class PantallaOrdenMerito {
      + solicitarPuesto()
      + mostrarPuestos(puestos: List<PuestoDTO>)
      + solicitarEvaluaciones(evaluaciones: List<EvaluacionResumenDTO>)
      + mostrarListadoOrdenMerito()
      + solicitarImpresion()
  }

  class PantallaGestionPreguntas {
      + mostrarFiltros(competencias: List<CompetenciaDTO>)
      + mostrarFactores(factores: List<FactorDTO>)
      + mostrarListaPreguntas(preguntas: List<PreguntaDTO>)
  }

  class PantallaAltaPregunta {
      + mostrarFormulario(competencias: List<CompetenciaDTO>, opciones: List<OpcionRespuestaDTO>)
      + mostrarFactores(factores: List<FactorDTO>)
      + mostrarGrillaOpciones(opciones: List<OpcionRespuestaDTO>)
      + completarConDatosIA(pregunta: PreguntaDTO)
  }

  class PantallaEvaluacion {
      + mostrarGrillaCandidatos(candidatos: List<CandidatoDTO>)
      + mostrarPuestos(puestos: List<PuestoDTO>)
      + mostrarCaracteristicasPuesto(caracteristicas: List<CaracteristicaPuestoDTO>)
      + mostrarClaves(claves: List<ClaveCandidatoDTO>)
      + solicitarUbicacionExcel()
  }

  class PantallaCuestionario {
      + mostrarInstrucciones()
      + mostrarBloque(bloque: BloqueCuestionarioDTO)
      + validarRespuestasCompletas(): Boolean
      + mostrarErrorPreguntasSinResponder()
      + mostrarMensajeFinalizacion()
  }
}
