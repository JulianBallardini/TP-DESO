' ==========================================
' DOMINIO (ENTIDADES)
' ==========================================
package "Entidades" {
  class Usuario {
      - id: Integer
      - nombre: String
      - apellido: String
  }
  
  class Consultor {
      - idUsuario: String
      - legajo: String
      - clave: String
  }
  
  class Candidato {
      - tipoDocumento: String
      - nroDocumento: String
      - activo: Boolean
      + esAutenticacionValida(): Boolean
      + completarCuestionario()
      + getCuestionarios()
  }
  
  Usuario <|-- Consultor
  Usuario <|-- Candidato
  
  class Puesto {
      - codigo: String
      - nombrePuesto: String
      - empresa: String
      - descripcion: String
      - estaActivo: Boolean
      + esValido(): Boolean
      + desactivarPuesto(): void
      + getPonderaciones()
  }
  
  class CaracteristicaPuesto {
      - ponderacion: Integer
      + validarPonderacion(): Boolean
      + getCompetencia()
  }
  
  class Evaluacion {
      - codigo: String
      - fechaCreacion: Date
      - tiempoMaximo: Integer
      - fechaInicio: Date
      - estado: EstadoEvaluacion
      + agregarEvaluacionCandidato(evaluacionCandidato: EvaluacionCandidato)
  }
  
  class EvaluacionCandidato {
      - puntajeObtenidoTotal: Float
      + finalizarCuestionario(puntaje: Float)
      + getEvaluacionCompetencias()
      + getEstado()
      + asociarCuestionario(cuestionario: Cuestionario)
      + agregarEvaluacionCompetencia(evaluacionCompetencia: EvaluacionCompetencia)
  }
  
  class EvaluacionCompetencia {
      - puntajeObtenido: Float
      + getCompetencia()
  }
  
  class Cuestionario {
      - id: Integer
      - fechaCreacion: Date
      - estado: EstadoCuestionario
      - accesosConcretados: Integer
      - accesosPermitidos: Integer
      - diaComienzo: Date
      - horaComienzo: Time
      - fechaFin: DateTime
      - clave: String
      + iniciar(): void
      + guardarProgreso(): void
      + finalizar(): void
      + corroborarTiempo(tiempoMax: Time, dia: Date, hora: Time): Boolean
      + estaVencido(): Boolean
      + superoCantidadAccesos(): Boolean
      + registrarAcceso()
  }
  
  class BloqueCuestionario {
      - numero: Integer
      - completado: Boolean
  }
  
  class RespuestaCandidato {
      - fechaRespuesta: Date
  }
  
  class Competencia {
      - codigo: Integer
      - nombre: String
      - descripcion: String
      - activo: Boolean
  }
  
  class Factor {
      - codigo: Integer
      - nombre: String
      - nroOrden: Integer
      - descripcion: String
      - activo: Boolean
  }
  
  class Pregunta {
      - nombre: String
      - enunciado: String
      - descripcion: String
      - tipo: TipoPregunta
      - activo: Boolean
  }
  
  class OpcionRespuesta {
      - texto: String
      - ponderacion: Double
      - esCorrecta: Boolean
  }
  
  class RegistroAuditoria {
      - id: Integer
      - fechaHora: DateTime
      - accion: String
      - entidadAfectada: String
  }
  
  class RepositorioDeConfiguraciones {
    - instrucciones: String
    - parametros: String
    - tiempoMaximoActivo: Integer
  }
}

