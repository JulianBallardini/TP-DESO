  class GestorRegistro #ADF7F5{
      + generarRegistro(fechaHora: Date, accion: String, entidadAfectada: String, idConsultor: Integer): RegistroAuditoriaDTO
  }
  
  class GestorCuestionario #ADF7F5{
      + gestionarCuestionarioEnCurso(idEvaluacionCandidato: Integer): CuestionarioDTO
      + puedeAcceder(): Boolean
      - estaVencido(): Boolean
      - registrarAcceso(): void
