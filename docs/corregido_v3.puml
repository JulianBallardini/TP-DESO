  class GestorOrdenMerito #ADF7F5{
      + buscarEvaluacionesDelPuesto(idPuesto: Integer): List<EvaluacionResumenDTO>
      + emitirOrdenMerito(idPuesto: Integer, idsEvaluaciones: List<Integer>): OrdenMeritoDTO
