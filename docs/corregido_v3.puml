      + buscarPorDocumento(tipoDoc: String, nroDoc: String): Usuario
  }

  class UsuarioDAO #DAFFBA{
      + buscarPorId(id: Integer): Usuario
      + buscarPorCredenciales(usuario: String, clave: String): Usuario
      + buscarPorDocumento(tipoDoc: String, nroDoc: String): Usuario
  }
  UsuarioDAO ..|> IUsuarioDAO
  
  interface IEvaluacionCompetenciaDAO #FFFFB8{
      + insertar(evaluacionCompetencia: EvaluacionCompetencia): void
      + modificar(evaluacionCompetencia: EvaluacionCompetencia): void
      + buscarPorEvaluacionCandidato(idEvaluacionCandidato: Integer): List<EvaluacionCompetencia>
      + buscarPorCompetencia(idCompetencia: Integer): List<EvaluacionCompetencia>
  }

  class EvaluacionCompetenciaDAO #DAFFBA{
      + insertar(evaluacionCompetencia: EvaluacionCompetencia): void
      + modificar(evaluacionCompetencia: EvaluacionCompetencia): void
      + buscarPorEvaluacionCandidato(idEvaluacionCandidato: Integer): List<EvaluacionCompetencia>
      + buscarPorCompetencia(idCompetencia: Integer): List<EvaluacionCompetencia>
  }
  EvaluacionCompetenciaDAO ..|> IEvaluacionCompetenciaDAO
  
  interface ICaracteristicaPuestoDAO #FFFFB8{
      + insertar(caracteristica: CaracteristicaPuesto): void
      + modificar(caracteristica: CaracteristicaPuesto): void
      + eliminar(id: Integer): void
      + buscarPorPuesto(idPuesto: Integer): List<CaracteristicaPuesto>
      + buscarPorCompetencia(idCompetencia: Integer): List<CaracteristicaPuesto>
  }

  class CaracteristicaPuestoDAO #DAFFBA{
      + insertar(caracteristica: CaracteristicaPuesto): void
      + modificar(caracteristica: CaracteristicaPuesto): void
      + eliminar(id: Integer): void
      + buscarPorPuesto(idPuesto: Integer): List<CaracteristicaPuesto>
      + buscarPorCompetencia(idCompetencia: Integer): List<CaracteristicaPuesto>
  }
  CaracteristicaPuestoDAO ..|> ICaracteristicaPuestoDAO
  
  interface IRepositorioDeConfiguracionesDAO #FFFFB8{
      + buscarConfiguracion(): RepositorioDeConfiguraciones
  }

  class RepositorioDeConfiguracionesDAO #DAFFBA{
