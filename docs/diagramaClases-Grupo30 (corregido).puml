' ============================================================
' DAOs (Interfaces de Acceso a Datos - Solo Entidades)
' ============================================================
interface IUsuarioDAO <<dao>> {
  + buscarPorUser(user: String) : Usuario
  + findById(id: int) : Usuario
}

interface ICandidatoDAO <<dao>> {
