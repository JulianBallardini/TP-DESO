  + findById(id: int) : Candidato
  + guardar(c: Candidato) : void
  + actualizar(c: Candidato) : void
  + eliminarLogico(id: int) : void
}

interface IPuestoDAO <<dao>> {
  + buscar(codigo: String, nombre: String, empresa: String) : List<Puesto>
  + findById(id: int) : Puesto
