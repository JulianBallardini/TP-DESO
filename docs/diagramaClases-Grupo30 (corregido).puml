@startuml diagrama_clases_capital_humano_completo
skinparam classAttributeIconSize 0
skinparam linetype polyline

skinparam classBackgroundColor<<entity>> #FFFFFF
skinparam classBackgroundColor<<dto>> #B0E0E6
skinparam classBackgroundColor<<dao>> #FC8B79
skinparam classBackgroundColor<<service>> #F6D365
skinparam classBackgroundColor<<boundary>> #FFFF99
skinparam classBorderColor #3a7ab5
skinparam ArrowColor #444444

' ============================================================
' ENUMERACIONES
' ============================================================
enum EstadoCuestionario {
  ACTIVO
  EN_PROCESO
  COMPLETO
  INCOMPLETO
  SIN_CONTESTAR
}

enum TipoDocumento {
  DNI
  LE
  LC
  PP
}

enum Genero {
  H
  M
  X
}

' ============================================================
' ENTIDADES (Modelo de Dominio)
' ============================================================
entity Usuario <<entity>> {
  - idUsuario : int
  - nombre : String
  - activo : boolean
}

entity Candidato <<entity>> {
  - nroCandidato : int
  - apellido : String
  - nombre : String
  - nroDocumento : String
  - tipoDocumento : TipoDocumento
  - fechaNacimiento : Date
  - genero : Genero
  - nacionalidad : String
  - email : String
  - escolaridad : String
  - eliminado : boolean
}

entity Evaluacion <<entity>> {
  - idEvaluacion : int
  - fechaCreacion : Date
}

entity Cuestionario <<entity>> {
  - idCuestionario : int
  - clave : String
  - estado : EstadoCuestionario
  - fechaHoraInicio : DateTime
  - fechaHoraFin : DateTime
  - fechaHoraUltimoIngreso : DateTime
  - cantidadAccesos : int
  - maximoAccesos : int
  - tiempoMaximo : int
}

entity Puesto <<entity>> {
  - codigo : String
  - nombre : String
  - descripcion : String
  - empresa : String
  - activo : boolean
}

entity CaracteristicaPuesto <<entity>> {
  - ponderacionMinima : double
}

entity Competencia <<entity>> {
  - codigo : String
  - nombre : String
  - descripcion : String
  - activo : boolean
}

entity Factor <<entity>> {
  - codigo : String
  - nombre : String
  - descripcion : String
  - nroOrden : int
  - activo : boolean
}

entity BloquePreguntas <<entity>> {
  - idBloque : int
  - nroBloque : int
  - completado : boolean
}

entity Pregunta <<entity>> {
  - idPregunta : int
  - nombre : String
  - textoPregunta : String
  - descripcion : String
  - activo : boolean
}

entity OpcionRespuesta <<entity>> {
  - idOpcionRespuesta : int
  - nombre : String
  - descripcion : String
  - activo : boolean
}

entity ItemOpcionRespuesta <<entity>> {
  - orden : int
  - descripcion : String
}

entity PreguntaCuestionario <<entity>> {
  - idPregCuest : int
  - nroOrden : int
  - respondida : boolean
}

entity ResultadoFactor <<entity>> {
  - puntajeObtenido : double
}

entity ResultadoCompetencia <<entity>> {
  - puntajeObtenido : double
}

entity RegistroAuditoria <<entity>> {
  - idRegistro : int
  - fechaHora : DateTime
  - usuario : String
  - accion : String
  - entidad : String
  - idEntidad : int
}

entity ConfiguracionSistema <<entity>> {
  - clave : String
  - valor : String
  - descripcion : String
}

entity OpcionPregunta <<entity>> {
  - idOpcionPregunta : int
  - ponderacion : double
}

